{
  "title": "Google Trends for AI Agents",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "tool": {
      "title": "What to run",
      "type": "string",
      "description": "One tool per run. Example: \"ask\" checks a single term and returns interest plus related queries. Standby/MCP callers ignore this input.",
      "editor": "select",
      "enum": [
        "ask",
        "snapshot",
        "compare",
        "now"
      ],
      "enumTitles": [
        "Quick check (trends_ask)",
        "Calibrated snapshot (trends_snapshot)",
        "Compare terms (trends_compare)",
        "Trending now (trends_now)"
      ],
      "default": "ask",
      "prefill": "ask",
      "sectionCaption": "Question",
      "sectionDescription": "A one-off run executes one tool and exits with a dataset row per term (one row per Trending Now item for \"now\"). Standby/MCP callers ignore this input."
    },
    "terms": {
      "title": "Terms",
      "type": "array",
      "description": "One or more search terms. Example: [\"Sora\"]. Ask and snapshot use one call per term; compare uses one call with 2–5 terms. Ignored by \"now\".",
      "editor": "stringList",
      "default": [],
      "prefill": [
        "Sora"
      ]
    },
