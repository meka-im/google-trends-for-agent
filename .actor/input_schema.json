    "window": {
      "title": "Time window",
      "type": "string",
      "description": "Explore time window. Example: \"now 7-d\". Trending Now maps this to the nearest supported window (4, 24, or 168 hours).",
      "editor": "select",
      "enum": [
        "now 1-H",
        "now 4-H",
        "now 1-d",
        "now 7-d",
        "today 1-m",
        "today 3-m",
        "today 12-m",
        "today 5-y",
        "all"
      ],
      "enumTitles": [
        "Past hour",
        "Past 4 hours",
        "Past day",
        "Past 7 days",
        "Past 30 days",
        "Past 90 days",
        "Past 12 months",
        "Past 5 years",
        "All time"
      ],
      "default": "now 1-d",
      "prefill": "now 1-d"
    },
    "anchor": {
      "title": "Calibration anchor",
      "type": "string",
      "description": "Anchor used to calibrate searches/day. Example: \"gpts\". Leave blank for automatic (sudoku for ≤1 day, gpts for 7 days and longer).",
      "editor": "select",
      "enum": [
        "",
        "gpts",
        "sudoku"
      ],
      "enumTitles": [
        "Automatic (sudoku ≤1 day, gpts 7 days+)",
        "gpts",
        "sudoku"
      ],
      "default": "",
      "prefill": "",
      "sectionCaption": "Calibration",
      "sectionDescription": "Most users can leave these unchanged."
    },
    "proxyConfiguration": {
      "title": "Proxy configuration",
      "type": "object",
      "description": "Egress for Google Trends requests inside the Actor. Example: Apify Residential proxy in the US. Residential traffic is billed per GB from your Apify credits.",
      "editor": "proxy",
      "default": {
        "useApifyProxy": true,
        "apifyProxyGroups": [
          "RESIDENTIAL"
        ],
        "apifyProxyCountry": "US"
      },
      "prefill": {
        "useApifyProxy": true,
        "apifyProxyGroups": [
          "RESIDENTIAL"
        ],
        "apifyProxyCountry": "US"
      },
      "sectionCaption": "Advanced: proxy",
      "sectionDescription": "Keep the default residential egress unless you have a reason to change it."
