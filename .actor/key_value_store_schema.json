{
  "actorKeyValueStoreSchemaVersion": 1,
  "title": "Google Trends key-value store",
  "description": "Run summaries, full native tool responses and chart images.",
  "collections": {
    "runtime": {
      "title": "Actual runtime version",
      "description": "Package version and calibration catalog revision from the running code, independent of the Apify build number.",
      "key": "GTFA_RUNTIME",
      "contentTypes": ["application/json"]
    },
    "runSummary": {
      "title": "Run summary",
      "description": "One OUTPUT record per run.",
      "key": "OUTPUT",
      "contentTypes": [
        "application/json"
      ],
      "jsonSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "partial",
              "failed"
            ]
          },
          "tool": {
            "type": "string",
            "enum": [
              "ask",
              "snapshot",
              "compare",
              "now"
            ]
          },
          "geo": {
            "type": "string"
          },
          "window": {
            "type": "string"
          },
          "terms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "delivered": {
            "type": "integer",
            "minimum": 0
          },
          "noData": {
            "type": "integer",
            "minimum": 0
          },
          "blocked": {
            "type": "integer",
            "minimum": 0
          },
          "skipped": {
            "type": "integer",
            "minimum": 0
          },
          "errors": {
            "type": "integer",
            "minimum": 0
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0
          },
          "completed": {
            "type": "boolean"
          },
          "partial": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "tool",
          "geo",
          "window",
          "terms",
          "delivered",
          "noData",
          "blocked",
          "errors",
          "durationMs",
          "completed",
          "partial",
          "message"
        ]
      }
    },
    "charts": {
      "title": "Charts",
      "description": "SVG or PNG charts referenced from the dataset.",
      "keyPrefix": "chart-",
      "contentTypes": [
        "image/png",
        "image/svg+xml"
      ]
    },
    "nativeResponse": {
      "title": "Native tool response",
      "key": "TOOL_RESPONSE",
      "contentTypes": [
        "application/json"
      ],
      "description": "On-demand protocol v1: full result envelope and snapshot history; no Dataset v1 shape change."
    }
  }
}
